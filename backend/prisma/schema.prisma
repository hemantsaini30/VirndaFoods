// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  RESTAURANT_OWNER
  DELIVERY_PARTNER
  ADMIN
}

enum RestaurantApplicationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum RestaurantStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum DeliveryPartnerApplicationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum OrderStatus {
  CREATED
  PAYMENT_PENDING
  PAYMENT_FAILED
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  INITIATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUND_INITIATED
  REFUNDED
}

enum DeliveryAssignmentStatus {
  PENDING_ASSIGNMENT
  OFFERED
  ACCEPTED
  REJECTED
  PICKED_UP
  DELIVERED
  CANCELLED
}

enum TriggeredBy {
  WEBHOOK
  ADMIN
  SYSTEM_JOB
  USER
}

enum NotificationType {
  ORDER_UPDATE
  PAYMENT_UPDATE
  APPLICATION_UPDATE
  ASSIGNMENT_UPDATE
  GENERIC
}

// ─────────────────────────────────────────────────────────
// USERS
// ─────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         UserRole
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurantApplications      RestaurantApplication[]
  ownedRestaurants            Restaurant[]
  deliveryPartnerApplications DeliveryPartnerApplication[]
  cart                        Cart?
  ordersAsCustomer            Order[]                       @relation("CustomerOrders")
  deliveryAssignments         DeliveryAssignment[]          @relation("DriverAssignments")
  driverLocations             DriverLocation[]
  reviews                     Review[]
  notifications               Notification[]
  refreshTokens               RefreshToken[]

  @@index([email])
  @@index([role])
  @@map("users")
}

// ─────────────────────────────────────────────────────────
// AUTH — REFRESH TOKENS (NEW in Phase 2)
// ─────────────────────────────────────────────────────────

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  tokenHash  String    @unique
  revokedAt  DateTime?
  replacedBy String?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────────────────
// RESTAURANT ONBOARDING
// ─────────────────────────────────────────────────────────

model RestaurantApplication {
  id           String                      @id @default(uuid())
  applicantId  String
  applicant    User                        @relation(fields: [applicantId], references: [id])
  name         String
  address      String
  city         String
  documentsUrl String?
  status       RestaurantApplicationStatus @default(PENDING)
  reviewedBy   String?
  reviewNote   String?
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt

  restaurant Restaurant?

  @@index([applicantId])
  @@index([status])
  @@map("restaurant_applications")
}

model Restaurant {
  id            String                @id @default(uuid())
  applicationId String                @unique
  application   RestaurantApplication @relation(fields: [applicationId], references: [id])
  ownerId       String
  owner         User                  @relation(fields: [ownerId], references: [id])
  name          String
  address       String
  city          String
  imageUrl      String?
  status        RestaurantStatus      @default(ACTIVE)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  menuCategories MenuCategory[]
  foodItems      FoodItem[]
  orders         Order[]

  @@index([ownerId])
  @@index([status])
  @@map("restaurants")
}

model MenuCategory {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  name         String
  displayOrder Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  foodItems FoodItem[]

  @@index([restaurantId])
  @@map("menu_categories")
}

model FoodItem {
  id           String       @id @default(uuid())
  restaurantId String
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id])
  categoryId   String
  category     MenuCategory @relation(fields: [categoryId], references: [id])
  name         String
  description  String?
  imageUrl     String?
  priceInPaise Int
  isAvailable  Boolean      @default(true)
  version      Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([restaurantId])
  @@index([categoryId])
  @@map("food_items")
}

// ─────────────────────────────────────────────────────────
// CART
// ─────────────────────────────────────────────────────────

model Cart {
  id           String   @id @default(uuid())
  customerId   String   @unique
  customer     User     @relation(fields: [customerId], references: [id])
  restaurantId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items CartItem[]

  @@map("carts")
}

model CartItem {
  id         String   @id @default(uuid())
  cartId     String
  cart       Cart     @relation(fields: [cartId], references: [id])
  foodItemId String
  foodItem   FoodItem @relation(fields: [foodItemId], references: [id])
  quantity   Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([cartId])
  @@map("cart_items")
}

// ─────────────────────────────────────────────────────────
// ORDERS
// ─────────────────────────────────────────────────────────

model Order {
  id                 String      @id @default(uuid())
  customerId         String
  customer           User        @relation("CustomerOrders", fields: [customerId], references: [id])
  restaurantId       String
  restaurant         Restaurant  @relation(fields: [restaurantId], references: [id])
  deliveryPartnerId  String?
  status             OrderStatus @default(CREATED)
  subtotalInPaise    Int
  deliveryFeeInPaise Int
  discountInPaise    Int         @default(0)
  totalInPaise       Int
  deliveryAddress    String
  version            Int         @default(0)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  items              OrderItem[]
  payment            Payment?
  deliveryAssignment DeliveryAssignment?
  events             OrderEvent[]
  review             Review?

  @@index([customerId])
  @@index([restaurantId])
  @@index([deliveryPartnerId])
  @@index([status])
  @@index([createdAt])
  @@index([restaurantId, status, createdAt])
  @@map("orders")
}

model OrderItem {
  id                     String   @id @default(uuid())
  orderId                String
  order                  Order    @relation(fields: [orderId], references: [id])
  foodItemId             String
  foodItem               FoodItem @relation(fields: [foodItemId], references: [id])
  quantity               Int
  priceAtPurchaseInPaise Int
  createdAt              DateTime @default(now())

  @@index([orderId])
  @@map("order_items")
}

model OrderEvent {
  id            String       @id @default(uuid())
  orderId       String
  order         Order        @relation(fields: [orderId], references: [id])
  fromStatus    OrderStatus?
  toStatus      OrderStatus
  triggeredBy   TriggeredBy
  triggeredById String?
  reason        String?
  rawPayload    Json?
  createdAt     DateTime     @default(now())

  @@index([orderId])
  @@map("order_events")
}

// ─────────────────────────────────────────────────────────
// PAYMENTS
// ─────────────────────────────────────────────────────────

model Payment {
  id                String        @id @default(uuid())
  orderId           String        @unique
  order             Order         @relation(fields: [orderId], references: [id])
  provider          String        @default("razorpay")
  providerOrderId   String?
  providerPaymentId String?       @unique
  status            PaymentStatus @default(INITIATED)
  amountInPaise     Int
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  events PaymentEvent[]

  @@index([orderId])
  @@index([providerPaymentId])
  @@map("payments")
}

model PaymentEvent {
  id            String         @id @default(uuid())
  paymentId     String
  payment       Payment        @relation(fields: [paymentId], references: [id])
  fromStatus    PaymentStatus?
  toStatus      PaymentStatus
  triggeredBy   TriggeredBy
  triggeredById String?
  reason        String?
  rawPayload    Json?
  createdAt     DateTime       @default(now())

  @@index([paymentId])
  @@map("payment_events")
}

// ─────────────────────────────────────────────────────────
// DELIVERY PARTNER ONBOARDING & ASSIGNMENT
// ─────────────────────────────────────────────────────────

model DeliveryPartnerApplication {
  id          String                            @id @default(uuid())
  applicantId String
  applicant   User                              @relation(fields: [applicantId], references: [id])
  vehicleType String
  licenseUrl  String?
  status      DeliveryPartnerApplicationStatus  @default(PENDING)
  reviewedBy  String?
  reviewNote  String?
  createdAt   DateTime                          @default(now())
  updatedAt   DateTime                          @updatedAt

  @@index([applicantId])
  @@index([status])
  @@map("delivery_partner_applications")
}

model DeliveryAssignment {
  id          String                   @id @default(uuid())
  orderId     String                   @unique
  order       Order                    @relation(fields: [orderId], references: [id])
  driverId    String
  driver      User                     @relation("DriverAssignments", fields: [driverId], references: [id])
  status      DeliveryAssignmentStatus @default(PENDING_ASSIGNMENT)
  offeredAt   DateTime?
  acceptedAt  DateTime?
  pickedUpAt  DateTime?
  deliveredAt DateTime?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  @@index([driverId])
  @@index([orderId])
  @@index([status])
  @@map("delivery_assignments")
}

model DriverLocation {
  id         String   @id @default(uuid())
  driverId   String
  driver     User     @relation(fields: [driverId], references: [id])
  latitude   Float
  longitude  Float
  recordedAt DateTime @default(now())

  @@index([driverId])
  @@index([recordedAt])
  @@map("driver_locations")
}

// ─────────────────────────────────────────────────────────
// REVIEWS & NOTIFICATIONS
// ─────────────────────────────────────────────────────────

model Review {
  id         String   @id @default(uuid())
  orderId    String   @unique
  order      Order    @relation(fields: [orderId], references: [id])
  customerId String
  customer   User     @relation(fields: [customerId], references: [id])
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  @@index([customerId])
  @@map("reviews")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  title     String
  body      String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId])
  @@map("notifications")
}

// ─────────────────────────────────────────────────────────
// IDEMPOTENCY
// ─────────────────────────────────────────────────────────

model IdempotencyKey {
  id                 String   @id @default(uuid())
  key                String   @unique
  userId             String
  route              String
  requestFingerprint String
  responseStatusCode Int?
  responseBody       Json?
  createdAt          DateTime @default(now())
  expiresAt          DateTime

  @@index([key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}