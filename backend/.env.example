# Copy this file to .env (cp .env.example .env) — the values below already
# match docker-compose.yml's defaults, so local dev works with zero edits.

NODE_ENV=development
PORT=4000

# Matches docker-compose.yml postgres service (user/password/db)
DATABASE_URL="postgresql://fooduser:foodpass@localhost:5433/food_delivery_dev?schema=public"

# Matches docker-compose.yml redis service
REDIS_URL="redis://localhost:6379"

# JWT secrets are unused in Phase 1 (auth arrives in Phase 2) but declared now
# so the env schema is stable across phases. Any non-empty string works locally.
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"

# CORS origin for the Vite frontend dev server
CORS_ORIGIN="http://localhost:5173"
