NODE_ENV=development
PORT=4000

DATABASE_URL="postgresql://fooduser:foodpass@localhost:5432/food_delivery_dev?schema=public"
REDIS_URL="redis://localhost:6379"

JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"

# Access token lifetime, in a format jsonwebtoken understands (e.g. "15m", "1h")
ACCESS_TOKEN_TTL=15m
# Refresh token lifetime, in whole days
REFRESH_TOKEN_TTL_DAYS=7
# bcrypt work factor for password hashing
BCRYPT_COST=12
# Whether the refresh-token cookie requires HTTPS. Set to "true" in production.
COOKIE_SECURE=false

CORS_ORIGIN="http://localhost:5173"