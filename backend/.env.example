NODE_ENV=development
PORT=4000

DATABASE_URL="postgresql://fooduser:foodpass@localhost:5432/food_delivery_dev?schema=public"
REDIS_URL="redis://localhost:6379"

JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"

# Access token lifetime, in a format jsonwebtoken understands (e.g. "15m", "1h")
ACCESS_TOKEN_TTL=15m
# Refresh token lifetime, in whole days
REFRESH_TOKEN_TTL_DAYS=7
# bcrypt work factor for password hashing
BCRYPT_COST=12
# Whether the refresh-token cookie requires HTTPS. Set to "true" in production.
COOKIE_SECURE=false

CORS_ORIGIN="http://localhost:5173"

# Initial admin account, created idempotently by `npm run seed`.
# Change these before running the seed against anything beyond your local machine.
ADMIN_EMAIL="admin@fooddelivery.local"
ADMIN_PASSWORD="ChangeMe123!"
ADMIN_NAME="Platform Admin"

# Cloudinary — used for signed direct-from-browser uploads of restaurant
# and food item images (Phase 4). The frontend never sees CLOUDINARY_API_SECRET;
# it only receives a short-lived signature from our backend.
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
# Folder inside your Cloudinary account that uploads are scoped to, so this
# project's images are easy to find/manage separately from anything else
# in the same account.
CLOUDINARY_UPLOAD_FOLDER="food-delivery-dev"