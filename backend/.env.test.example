# Copy this to .env.test (cp .env.test.example .env.test).
# Same Postgres container, but a SEPARATE database so tests never touch your
# real dev data. We create this second database once during setup (see SETUP.md).

NODE_ENV=test
PORT=4001

DATABASE_URL="postgresql://fooduser:foodpass@localhost:5432/food_delivery_test?schema=public"
REDIS_URL="redis://localhost:6379"

JWT_ACCESS_SECRET="test-access-secret"
JWT_REFRESH_SECRET="test-refresh-secret"

CORS_ORIGIN="http://localhost:5173"

ADMIN_EMAIL="admin@fooddelivery.local"
ADMIN_PASSWORD="ChangeMe123!"
ADMIN_NAME="Platform Admin"